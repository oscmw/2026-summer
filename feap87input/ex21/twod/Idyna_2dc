feap: 2-D Solid Transient solution with consistent mass
  0 0 0 2 2 4

parameter
  n = 10
  pi = acos(-1)

mate 1
  solid
    elastic isotropic 2500 0.25
    density mass      10
    mass consist


block
  cart n 1
   quad 4
    1  5.0 0.0
    2 10.0 0.0
    3 10.0 0.5
    4  5.0 0.5

eboun
  1 10.0 1 0
  2  0.0 0 1
  2  0.5 0 1

eforc
  1 5 0.5


end

batch
  comm ex21_2d_cons_mass
  prop
end
 1 2 0 0.7 0 0 1 pi/0.7 0

batch
  trans newmark
  dt,,0.01
  loop,,20
    loop,,5
      time
      loop,,3
        tang,,1
      next
    next
    plot hfram 1
    plot cont 1
    plot hfram 2
    plot stres 1
    plot title
  next
end

inter

stop

